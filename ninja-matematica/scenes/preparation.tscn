autowrap_mode = 2

[node name="HardDetails" type="Label" parent="HUD/Root/DifficultyHelp/HelpCard/HelpContent" unique_id=2114074985]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 23
text = "DIFÍCIL
