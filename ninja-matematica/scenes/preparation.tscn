[node name="NormalDetails" type="Label" parent="HUD/Root/DifficultyHelp/HelpCard/HelpContent" unique_id=1115507118]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 23
text = "NORMAL
