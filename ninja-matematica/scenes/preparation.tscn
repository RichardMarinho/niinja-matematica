horizontal_alignment = 1

[node name="EasyDetails" type="Label" parent="HUD/Root/DifficultyHelp/HelpCard/HelpContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 23
text = "FÁCIL\nAs contas são tranquilas. Os doces vêm devagar e sobra tempo pra pensar. Se errar, perde só um pouquinho de tempo."
autowrap_mode = 2
size_flags_vertical = 3

[node name="NormalDetails" type="Label" parent="HUD/Root/DifficultyHelp/HelpCard/HelpContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 23
text = "NORMAL\nDesafio na medida! As contas e a velocidade ficam no meio. Errou? Perde um pouco de tempo."
autowrap_mode = 2
size_flags_vertical = 3

[node name="HardDetails" type="Label" parent="HUD/Root/DifficultyHelp/HelpCard/HelpContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 23
text = "DIFÍCIL\nPartiu desafio? As contas ficam mais difíceis, os doces voam e sobra menos tempo. Errar tira mais tempo."
autowrap_mode = 2
size_flags_vertical = 3

